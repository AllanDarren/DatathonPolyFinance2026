{
  "name": "alphaforge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:data && vite",
    "dev:mock": "npm run build:data && VITE_MOCK=1 vite",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "npm run build:data && tsc -b --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "build:data": "node scripts/build-data.mjs",
    "pretest": "npm run build:data"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
